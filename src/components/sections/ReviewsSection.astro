---
import { t, type Locale } from '../../i18n/utils';
import { airbnbRating, airbnbProfileUrl } from '../../data/siteConfig';
import { reviews, reviewMeta } from '../../data/reviews';
import SuperhostBadge from '../ui/SuperhostBadge.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const allReviewsCta = {
  fr: `Lire les ${airbnbRating.count} avis sur Airbnb`,
  en: `Read all ${airbnbRating.count} reviews on Airbnb`,
}[locale];
---
<section class="bg-white py-16 lg:py-20">
  <div class="max-w-[1200px] mx-auto px-6 lg:px-16">
    <h2 class="font-heading text-ayaba-dark text-[24px] lg:text-[32px] font-bold text-center mb-4">
      {t(locale, 'home.reviewsTitle')}
    </h2>
    <div class="flex justify-center mb-10">
      <SuperhostBadge locale={locale} tone="onLight" />
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {reviews.map((review) => (
        <figure class="bg-ayaba-cream rounded-xl p-6 flex flex-col">
          <p class="text-ayaba-gold text-sm mb-2" aria-hidden="true">★★★★★</p>
          <blockquote class="text-ayaba-dark text-sm leading-relaxed italic mb-3 flex-1">"{review.text[locale]}"</blockquote>
          <figcaption class="text-ayaba-muted text-[13px] font-semibold">
            — {review.author} <span class="font-normal">· {reviewMeta(review, locale)}</span>
          </figcaption>
        </figure>
      ))}
    </div>

    <p class="text-center mt-10">
      <a
        href={airbnbProfileUrl}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 text-ayaba-terra font-semibold text-[15px] underline decoration-ayaba-terra/30 underline-offset-4 hover:decoration-ayaba-terra transition-colors"
      >
        {allReviewsCta}
        <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.22 14.78a.75.75 0 001.06 0l7.22-7.22v5.69a.75.75 0 001.5 0v-7.5a.75.75 0 00-.75-.75h-7.5a.75.75 0 000 1.5h5.69l-7.22 7.22a.75.75 0 000 1.06z" clip-rule="evenodd"/></svg>
      </a>
    </p>
  </div>
</section>
